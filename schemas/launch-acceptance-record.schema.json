{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.bca.wales/launch-acceptance-record/1.0.0.json",
  "title": "BCA production launch acceptance record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "service", "application_commit", "evidence_release_id", "evidence_manifest_sha256", "candidate_created_at", "finalised_at", "approval", "promotion", "rollback", "expected_monthly_cost_gbp", "results"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "service": { "const": "Blorenge landscape explorer" },
    "application_commit": { "$ref": "#/$defs/commit" },
    "evidence_release_id": { "type": "string", "pattern": "^release-[a-z0-9][a-z0-9._-]+$" },
    "evidence_manifest_sha256": { "$ref": "#/$defs/sha256" },
    "candidate_created_at": { "type": "string", "format": "date-time" },
    "finalised_at": { "type": ["string", "null"], "format": "date-time" },
    "approval": {
      "type": "object", "additionalProperties": false, "required": ["authority", "status", "approved_at", "evidence"],
      "properties": {
        "authority": { "const": "Tim Roberts" }, "status": { "enum": ["pending", "approved", "rejected"] },
        "approved_at": { "type": ["string", "null"], "format": "date-time" }, "evidence": { "type": ["string", "null"] }
      }
    },
    "promotion": {
      "type": "object", "additionalProperties": false, "required": ["site_url", "asset_origin", "pages_deployment", "current_pointer", "promoted_at", "production_verification"],
      "properties": {
        "site_url": { "type": "string", "format": "uri" }, "asset_origin": { "type": "string", "format": "uri" },
        "pages_deployment": { "type": ["string", "null"] }, "current_pointer": { "type": ["string", "null"] },
        "promoted_at": { "type": ["string", "null"], "format": "date-time" }, "production_verification": { "type": ["string", "null"] }
      }
    },
    "rollback": {
      "type": "object", "additionalProperties": false, "required": ["site_target", "evidence_target", "rehearsed_at", "result", "evidence"],
      "properties": {
        "site_target": { "type": ["string", "null"] }, "evidence_target": { "type": ["string", "null"] },
        "rehearsed_at": { "type": ["string", "null"], "format": "date-time" }, "result": { "enum": ["pending", "pass", "fail"] },
        "evidence": { "type": ["string", "null"] }
      }
    },
    "expected_monthly_cost_gbp": { "type": "number", "minimum": 0, "maximum": 25 },
    "results": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "tier", "result", "evidence", "waiver"],
        "properties": {
          "id": { "type": "string", "minLength": 1 }, "tier": { "enum": ["blocking", "non-critical", "advisory"] },
          "result": { "enum": ["pass", "fail", "pending", "not-run"] }, "evidence": { "type": "string", "minLength": 1 },
          "waiver": { "type": ["object", "null"], "additionalProperties": false, "required": ["approved_by", "expires_at", "reason"], "properties": { "approved_by": { "const": "Tim Roberts" }, "expires_at": { "type": "string", "format": "date-time" }, "reason": { "type": "string", "minLength": 1 } } }
        }
      }
    }
  },
  "$defs": {
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
