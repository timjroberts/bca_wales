{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.bca.wales/release-manifest/1.0.0.json",
  "title": "BCA public evidence release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release_id",
    "dataset_version",
    "created_at",
    "published_at",
    "registry_commit",
    "code_commit",
    "supersedes",
    "superseded_by",
    "promotion",
    "gate",
    "datasets",
    "assets"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "release_id": { "type": "string", "pattern": "^release-[a-z0-9][a-z0-9._-]+$" },
    "dataset_version": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "published_at": { "type": ["string", "null"], "format": "date-time" },
    "registry_commit": { "$ref": "#/$defs/commit" },
    "code_commit": { "$ref": "#/$defs/commit" },
    "supersedes": { "type": ["string", "null"] },
    "superseded_by": { "type": ["string", "null"] },
    "promotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "identity"],
      "properties": {
        "mode": { "enum": ["manual", "automatic"] },
        "identity": { "type": "string", "minLength": 1 }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "result", "checked_at", "checks", "hard_failures", "warnings"],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "result": { "enum": ["pass", "fail"] },
        "checked_at": { "type": "string", "format": "date-time" },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "result", "message"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "result": { "enum": ["pass", "fail", "warning"] },
              "message": { "type": "string", "minLength": 1 }
            }
          }
        },
        "hard_failures": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "warnings": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "datasets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["dataset_id", "evidence_version", "title", "provider", "licence", "attribution", "classification", "observation_dates", "retrieved_at", "published_at", "method", "uncertainty", "limitations", "lineage"],
        "properties": {
          "dataset_id": { "type": "string", "minLength": 1 },
          "evidence_version": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "provider": { "type": "string", "minLength": 1 },
          "licence": { "type": "string", "minLength": 1 },
          "attribution": { "type": "string", "minLength": 1 },
          "classification": { "enum": ["authoritative", "provisional", "derived", "contextual", "historical"] },
          "observation_dates": { "type": "array", "minItems": 1, "items": { "type": "string", "format": "date" } },
          "retrieved_at": { "type": "string", "format": "date-time" },
          "published_at": { "type": ["string", "null"], "format": "date-time" },
          "method": { "type": "string", "minLength": 1 },
          "uncertainty": { "type": "string", "minLength": 1 },
          "limitations": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "lineage": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["asset_id", "dataset_id", "media_type", "url", "bytes", "sha256"],
        "properties": {
          "asset_id": { "type": "string", "minLength": 1 },
          "dataset_id": { "type": "string", "minLength": 1 },
          "media_type": { "enum": ["application/geo+json", "application/vnd.pmtiles", "image/tiff; application=geotiff; profile=cloud-optimized", "text/csv", "application/json"] },
          "url": { "type": "string", "format": "uri" },
          "bytes": { "type": "integer", "minimum": 1 },
          "sha256": { "$ref": "#/$defs/sha256" }
        }
      }
    }
  },
  "$defs": {
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
