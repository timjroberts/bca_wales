{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.bca.wales/acquisition-manifest/1.0.0.json",
  "title": "BCA acquisition manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_id", "release_id", "registry_id", "registry_sha256", "recipe_sha256", "code_commit", "created_at", "checksum_algorithm", "inputs", "licence_snapshots", "qa_events"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "manifest_id": { "type": "string", "minLength": 1 },
    "release_id": { "type": "string", "minLength": 1 },
    "registry_id": { "type": "string", "minLength": 1 },
    "registry_sha256": { "$ref": "#/$defs/sha256" },
    "recipe_sha256": { "$ref": "#/$defs/sha256" },
    "code_commit": { "$ref": "#/$defs/commit" },
    "created_at": { "type": "string", "format": "date-time" },
    "checksum_algorithm": { "const": "sha256" },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["input_id", "dataset_id", "retrieved_at", "resolved_url", "response", "path", "media_type", "byte_length", "sha256", "expected_sha256", "checksum_status"],
        "properties": {
          "input_id": { "type": "string", "minLength": 1 },
          "dataset_id": { "type": "string", "minLength": 1 },
          "retrieved_at": { "type": "string", "format": "date-time" },
          "resolved_url": { "type": "string", "minLength": 1 },
          "response": { "type": "object" },
          "path": { "type": "string", "minLength": 1 },
          "media_type": { "type": "string", "minLength": 1 },
          "byte_length": { "type": "integer", "minimum": 1 },
          "sha256": { "$ref": "#/$defs/sha256" },
          "expected_sha256": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
          "checksum_status": { "enum": ["matched", "unreviewed", "changed"] }
        }
      }
    },
    "licence_snapshots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["dataset_id", "source_path", "path", "byte_length", "sha256", "checksum_status"],
        "properties": {
          "dataset_id": { "type": "string", "minLength": 1 },
          "source_path": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "byte_length": { "type": "integer", "minimum": 1 },
          "sha256": { "$ref": "#/$defs/sha256" },
          "checksum_status": { "enum": ["matched", "changed"] }
        }
      }
    },
    "qa_events": { "type": "array", "items": { "$ref": "#/$defs/qa_event" } }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "qa_event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["severity", "code", "message"],
      "properties": {
        "severity": { "enum": ["information", "warning", "hard_fail"] },
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 }
      }
    }
  }
}
