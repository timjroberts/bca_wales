{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "bca-wales-blog-local",
  "main": "dist/worker.mjs",
  "build": { "command": "node build.mjs" },
  "assets": { "directory": "dist/static", "binding": "ASSETS", "run_worker_first": true },
  "triggers": { "crons": ["0 * * * *"] },
  "compatibility_date": "2026-08-01",
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "ORIGIN": "http://localhost:8787",
    "AUTH_ENABLED": "false",
    "RESTRICTED": "false",
    "PUBLISH_PAUSED": "false"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "bca-wales-blog-local",
    "database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "migrations"
  }],
  "r2_buckets": [
    {"binding": "CONTENT", "bucket_name": "bca-wales-blog-local-content"},
    {"binding": "RECOVERY", "bucket_name": "bca-wales-blog-local-recovery"}
  ]
}
